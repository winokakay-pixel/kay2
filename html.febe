<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gelukkige Verjaardag Febe Vermesen</title>
<style>
  :root{
    --crimson: #a80f2c;
    --crimson-deep: #6e0a1e;
    --rose: #ff5c7a;
    --rose-soft: #ffb3c1;
    --cream: #fff5f2;
    --gold: #ffd873;
  }

  *{ box-sizing: border-box; }

  html, body{
    margin:0;
    padding:0;
    height:100%;
    background: radial-gradient(ellipse at top, var(--crimson) 0%, var(--crimson-deep) 65%, #3d0512 100%);
    font-family: 'Georgia', 'Times New Roman', serif;
    overflow-x:hidden;
    color: var(--cream);
  }

  .stage{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding: 70px 20px 90px 20px;
    perspective: 1600px;
    overflow:hidden;
  }

  /* --- confetti burst (3D tumbling) --- */
  .confetti-field{
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    pointer-events:none;
    overflow:hidden;
    z-index:0;
    perspective: 1000px;
  }

  .confetti{
    position:absolute;
    top:-40px;
    background: var(--gold);
    opacity:0;
    transform-style: preserve-3d;
    animation: fall linear forwards;
  }

  @keyframes fall{
    0%   { transform: translate3d(0,0,0) rotateX(0) rotateY(0) rotateZ(0); opacity:0; }
    8%   { opacity:1; }
    100% { transform: translate3d(var(--dx,0px), 105vh, var(--dz,0px)) rotateX(720deg) rotateY(540deg) rotateZ(360deg); opacity:0.15; }
  }

  /* --- ambient glow orbs --- */
  .orb{
    position:absolute;
    border-radius:50%;
    background: radial-gradient(circle, rgba(255,216,115,0.55) 0%, rgba(255,216,115,0) 72%);
    filter: blur(1px);
    animation: orbit ease-in-out infinite;
  }

  @keyframes orbit{
    0%, 100%{ transform: translate3d(0,0,0) scale(1); }
    50%{ transform: translate3d(var(--ox,30px), var(--oy,-30px), var(--oz,60px)) scale(1.3); }
  }

  /* --- card with live 3D tilt --- */
  .card-wrap{
    position:relative;
    z-index:2;
    transform-style: preserve-3d;
    transition: transform 0.15s ease-out;
    opacity:0;
  }

  .card-wrap.entered{
    animation: cardIn 1.1s cubic-bezier(.2,.8,.2,1) forwards;
  }

  @keyframes cardIn{
    0%{ opacity:0; transform: translateZ(-500px) rotateX(35deg); }
    100%{ opacity:1; transform: translateZ(0px) rotateX(0deg); }
  }

  .card{
    max-width: 660px;
    width:100%;
    background: linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,216,115,0.35);
    border-radius: 4px;
    padding: 56px 44px 40px 44px;
    text-align:center;
    box-shadow: 0 40px 90px rgba(0,0,0,0.5);
    backdrop-filter: blur(2px);
    transform-style: preserve-3d;
  }

  .eyebrow-number{
    font-size: 112px;
    line-height:1;
    font-weight:700;
    color: var(--gold);
    margin: 0 0 4px 0;
    letter-spacing: -2px;
    font-family: 'Georgia', serif;
    transform: translateZ(60px);
    animation: numberGlow 3.2s ease-in-out infinite alternate;
    opacity:0;
  }

  .card-wrap.entered .eyebrow-number{
    animation: numberFlip 0.9s 0.35s cubic-bezier(.2,.8,.2,1) forwards, numberGlow 3.2s 1.3s ease-in-out infinite alternate;
  }

  @keyframes numberFlip{
    0%{ opacity:0; transform: translateZ(60px) rotateY(-110deg); }
    100%{ opacity:1; transform: translateZ(60px) rotateY(0deg); }
  }

  @keyframes numberGlow{
    0%{ text-shadow: 0 0 18px rgba(255,216,115,0.35), 0 0 2px rgba(255,216,115,0.5); }
    100%{ text-shadow: 0 0 48px rgba(255,216,115,0.85), 0 0 10px rgba(255,216,115,0.7); }
  }

  .eyebrow-word{
    font-size: 16px;
    letter-spacing: 3px;
    color: var(--rose-soft);
    margin: 0 0 26px 0;
    transform: translateZ(40px);
    opacity:0;
  }

  .card-wrap.entered .eyebrow-word{
    animation: fadeUp 0.7s 0.75s ease-out forwards;
  }

  h1{
    font-size: 40px;
    margin: 0 0 6px 0;
    color: var(--cream);
    font-weight: 400;
    letter-spacing: 0.5px;
    transform: translateZ(45px);
    opacity:0;
  }

  .card-wrap.entered h1{
    animation: fadeUp 0.7s 0.9s ease-out forwards;
  }

  h1 em{
    font-style: normal;
    color: var(--gold);
  }

  .subtitle{
    font-size: 20px;
    color: var(--rose-soft);
    margin: 0 0 34px 0;
    font-style: italic;
    letter-spacing: 0.5px;
    transform: translateZ(35px);
    opacity:0;
  }

  .card-wrap.entered .subtitle{
    animation: fadeUp 0.7s 1.05s ease-out forwards;
  }

  @keyframes fadeUp{
    0%{ opacity:0; transform: translateZ(40px) translateY(14px); }
    100%{ opacity:1; transform: translateZ(40px) translateY(0); }
  }

  /* --- rotating 3D photo carousel with depth-based scale/blur (JS driven) --- */
  .carousel-scene{
    perspective: 1200px;
    height: 270px;
    margin: 8px 0 40px 0;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .ring{
    position:relative;
    width: 170px;
    height: 220px;
    transform-style: preserve-3d;
  }

  .photo{
    position:absolute;
    top:0; left:0;
    width: 170px;
    height: 220px;
    background: var(--cream);
    padding: 10px 10px 24px 10px;
    border-radius: 2px;
    box-shadow: 0 20px 45px rgba(0,0,0,0.55);
    backface-visibility: hidden;
    will-change: transform, opacity, filter;
  }

  .photo img{
    width:100%;
    height: 186px;
    object-fit: cover;
    display:block;
    filter: sepia(0.06) saturate(1.05);
  }

  .photo .cap{
    display:block;
    text-align:center;
    font-size: 11px;
    color: #6e0a1e;
    margin-top: 8px;
    letter-spacing: 1px;
    font-family: 'Georgia', serif;
  }

  .divider{
    width: 60px;
    height: 2px;
    background: var(--gold);
    margin: 0 auto 34px auto;
    opacity: 0.6;
    transform: translateZ(30px);
  }

  .message{
    font-size: 19px;
    line-height: 1.75;
    color: var(--cream);
    text-align: left;
    margin: 0 0 8px 0;
    transform: translateZ(25px);
  }

  .signoff{
    margin-top: 36px;
    font-size: 18px;
    color: var(--gold);
    font-style: italic;
    transform: translateZ(30px);
  }

  .small-hearts{
    margin-top: 28px;
    font-size: 22px;
    letter-spacing: 12px;
    color: var(--rose);
    transform: translateZ(25px);
  }

  @media (max-width: 480px){
    .card{ padding: 40px 22px 32px 22px; }
    .eyebrow-number{ font-size: 84px; }
    h1{ font-size: 30px; }
    .subtitle{ font-size: 17px; }
    .message{ font-size: 17px; }
    .carousel-scene{ height: 220px; }
    .ring{ width: 130px; height: 170px; }
    .photo{ width: 130px; height: 170px; }
    .photo img{ height: 136px; }
  }
</style>
</head>
<body>

<div class="confetti-field" id="confetti"></div>

<div class="stage">
  <div class="card-wrap" id="cardWrap">
    <div class="card">
      <p class="eyebrow-number">17</p>
      <p class="eyebrow-word">JAAR JONG</p>

      <h1>Gelukkige <em>Verjaardag</em></h1>
      <p class="subtitle">Febe Vermesen</p>

      <div class="carousel-scene">
        <div class="ring" id="ring">
          <div class="photo" data-angle="0">
            <img src="data:image/jpeg;base64," alt="Febe foto 1">
            <span class="cap">toen</span>
          </div>
          <div class="photo" data-angle="120">
            <img src="data:image/jpeg;base64," alt="Febe foto 2">
            <span class="cap">nu</span>
          </div>
          <div class="photo" data-angle="240">
            <img src="data:image/jpeg;base64," alt="Febe foto 3">
            <span class="cap">altijd jij</span>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <p class="message">
        Gefeliciteerd met je verjaardag Febe, ik hoop dat dit jaar vol geluk en voorspoed is. Ik wens het allerbeste voor jou Febe :)
      </p>
      <p class="message">
        Ik hoop het beste voor je studie en ik hou van je.
      </p>

      <p class="signoff">Met heel veel liefde</p>
      <div class="small-hearts">✦ ✦ ✦</div>
    </div>
  </div>
</div>

<script>
  // confetti burst, tumbling in 3D
  const cfield = document.getElementById('confetti');
  const colors = ['#ffd873', '#ff5c7a', '#fff5f2', '#e8a33d'];
  const totalConfetti = 46;
  for(let i=0;i<totalConfetti;i++){
    const c = document.createElement('div');
    c.className = 'confetti';
    const w = 6 + Math.random()*8;
    const h = 6 + Math.random()*14;
    c.style.width = w + 'px';
    c.style.height = h + 'px';
    c.style.left = Math.random()*100 + 'vw';
    c.style.background = colors[Math.floor(Math.random()*colors.length)];
    c.style.setProperty('--dx', (Math.random()*160-80) + 'px');
    c.style.setProperty('--dz', (Math.random()*300-150) + 'px');
    c.style.animationDuration = (4.5 + Math.random()*4) + 's';
    c.style.animationDelay = (Math.random()*3.5) + 's';
    cfield.appendChild(c);
  }

  // ambient glow orbs floating in depth
  for(let i=0;i<10;i++){
    const o = document.createElement('div');
    o.className = 'orb';
    const size = 30 + Math.random()*70;
    o.style.width = size + 'px';
    o.style.height = size + 'px';
    o.style.left = Math.random()*100 + 'vw';
    o.style.top = Math.random()*100 + 'vh';
    o.style.setProperty('--ox', (Math.random()*100-50) + 'px');
    o.style.setProperty('--oy', (Math.random()*100-50) + 'px');
    o.style.setProperty('--oz', (Math.random()*140) + 'px');
    o.style.animationDuration = (6 + Math.random()*6) + 's';
    o.style.animationDelay = (Math.random()*4) + 's';
    cfield.appendChild(o);
  }

  // entrance sequence
  window.addEventListener('load', () => {
    requestAnimationFrame(() => {
      document.getElementById('cardWrap').classList.add('entered');
    });
  });

  // JS-driven 3D carousel: continuous rotation with true depth scale/opacity/blur per photo
  const ring = document.getElementById('ring');
  const photos = Array.from(ring.querySelectorAll('.photo'));
  const radius = 230;
  let angle = 0;
  let paused = false;

  ring.parentElement.addEventListener('mouseenter', () => paused = true);
  ring.parentElement.addEventListener('mouseleave', () => paused = false);

  function renderRing(){
    if(!paused){ angle += 0.25; }
    photos.forEach(p => {
      const base = parseFloat(p.dataset.angle);
      const rad = (base + angle) * Math.PI / 180;
      const z = Math.cos(rad) * radius;
      const x = Math.sin(rad) * radius;
      const depth = (z + radius) / (2*radius); // 0 (far) -> 1 (near)
      const scale = 0.72 + depth * 0.5;
      const opacity = 0.35 + depth * 0.65;
      const blur = (1 - depth) * 3.5;
      const zIndex = Math.round(depth * 100);
      p.style.transform = `translate3d(${x}px, ${(1-depth)*10}px, ${z}px) scale(${scale})`;
      p.style.opacity = opacity;
      p.style.filter = `blur(${blur}px)`;
      p.style.zIndex = zIndex;
    });
    requestAnimationFrame(renderRing);
  }
  requestAnimationFrame(renderRing);

  // live 3D tilt following the pointer
  const wrap = document.getElementById('cardWrap');
  const stage = document.querySelector('.stage');
  let baseTransform = '';

  function applyTilt(x, y, rect){
    const px = (x - rect.left) / rect.width;
    const py = (y - rect.top) / rect.height;
    const rotateY = (px - 0.5) * 22;
    const rotateX = (0.5 - py) * 18;
    wrap.style.setProperty('--tiltX', rotateX + 'deg');
    wrap.style.setProperty('--tiltY', rotateY + 'deg');
    wrap.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
  }

  stage.addEventListener('mousemove', (e) => {
    const rect = stage.getBoundingClientRect();
    applyTilt(e.clientX, e.clientY, rect);
  });

  stage.addEventListener('mouseleave', () => {
    wrap.style.transform = 'rotateX(0deg) rotateY(0deg)';
  });

  stage.addEventListener('touchmove', (e) => {
    if(e.touches && e.touches[0]){
      const rect = stage.getBoundingClientRect();
      applyTilt(e.touches[0].clientX, e.touches[0].clientY, rect);
    }
  }, {passive:true});
</script>

</body>
</html>
